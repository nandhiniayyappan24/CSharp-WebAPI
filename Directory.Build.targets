<Project>
  <Target Name="ValidateNuGetAudit" BeforeTargets="Build" Condition="'$(MSBuildProjectName)' == 'CSharpWebApi'">
    <Message Importance="high" Text="[NuGet-Audit] Enabled for $(TargetFramework)" />
  </Target>
  <Target Name="ValidateOpenTelemetry" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'CSharpWebApi'">
    <Message Importance="high" Text="[OpenTelemetry] Wired via Extensions/OpenTelemetryExtensions.cs" />
  </Target>
  <Target Name="ValidateRoslyn" AfterTargets="CoreCompile" Condition="'$(MSBuildProjectName)' == 'CSharpWebApi'">
    <Message Importance="high" Text="[Roslyn] Analyzers and .editorconfig active during compile" />
  </Target>
  <Target Name="ValidateRoslynSast" AfterTargets="CoreCompile" Condition="'$(MSBuildProjectName)' == 'CSharpWebApi'">
    <Message Importance="high" Text="[roslyn-sast] Global config: tools/roslyn-sast/.globalconfig" />
  </Target>
</Project>
